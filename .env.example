# The key is deliberately kept outside the browser and outside source control.
PORT=3000
PRESTASHOP_URL=https://shop.example.com
PRESTASHOP_WEBSERVICE_KEY=

# Raben/Schenker beta estrema: il server Camofox resta sempre locale.
CAMOFOX_PORT=9377
CAMOFOX_URL=http://127.0.0.1:9377
# Facoltativo: stessa chiave per server Camofox e web app; non inserirla nell'interfaccia.
CAMOFOX_ACCESS_KEY=
CAMOFOX_CRASH_REPORT_ENABLED=false
# Su una workstation locale apre una finestra per effettuare l'accesso SSO umano.
# In un container lasciare "off" e usare una sessione persistente configurata separatamente.
CAMOFOX_INTERACTIVE=off
RABEN_TRACKING_URL=https://oftc.myraben.com/link/ShipmentInformation?ShipmentNumber=TRACKINGDAINSERIRE&Language=IT
